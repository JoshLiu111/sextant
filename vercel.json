{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["pdx1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "compute",
          "format": "url",
          "env": "COMPUTE_INTERNAL_URL"
        }
      ]
    },
    "compute": {
      "root": "apps/compute",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/compute/(.*)", "destination": { "service": "compute" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
