# Sextant environment variables. Names only; never commit values.
# Copy to .env.local (git-ignored) for local development and set real values
# in the Vercel project settings for Preview and Production.

# --- Frontend (apps/web) ---
# Base URL of the compute service for server-side calls when running locally.
# Defaults to http://127.0.0.1:8000. Not needed on Vercel: the service binding
# in vercel.json injects COMPUTE_INTERNAL_URL automatically.
COMPUTE_URL=
