# Sextant environment variables. Names only; never commit values.
# Copy to .env.local (git-ignored) for local development and set real values
# in the Vercel project settings for Preview and Production.

# --- Frontend (apps/web) ---
# Base URL of the compute service for server-side calls when running locally.
# Defaults to http://127.0.0.1:8000. Not needed on Vercel: the service binding
# in vercel.json injects COMPUTE_INTERNAL_URL automatically.
COMPUTE_URL=

# --- Accounts (ticket #5) ---
# Google OAuth client (type "Web application"). Used by apps/web only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string, at least 32 characters (e.g. `openssl rand -base64 48`).
# Must be identical for web and compute: web signs the login assertion with it
# and compute verifies it.
SESSION_SECRET=
# Optional. OpenID issuer; defaults to https://accounts.google.com. Only e2e
# tests override it (fake provider).
OIDC_ISSUER=

# --- Database (compute service) ---
# Injected by the Neon integration from the Vercel Marketplace. DATABASE_URL is
# the pooled URL used at runtime; DATABASE_URL_UNPOOLED (direct) is preferred
# for migrations. Without DATABASE_URL every tool still works; sign-in does not.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional. Set to 0 to stop the compute service from applying pending
# migrations on its first database connection (default 1).
DB_AUTO_MIGRATE=

# --- FRED (ticket #11, compute service) ---
# FRED API key (32 lowercase alphanumeric characters), from
# https://fred.stlouisfed.org/docs/api/api_key.html. Without it the Macro
# Dashboard shows "data source temporarily unavailable".
FRED_API_KEY=
# Optional. Defaults to https://api.stlouisfed.org/fred. Only e2e tests override
# it (fake FRED serving recorded responses).
FRED_API_BASE_URL=
